# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auth (Better Auth)
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Database (local docker-compose default)
DATABASE_URL=postgresql://prepgoat:prepgoat@localhost:5432/prepgoat
# Set true for Neon / cloud Postgres that requires SSL
DATABASE_SSL=false

# LLM evaluation (Groq)
GROQ_API_KEY=

# Google OAuth (optional — email/password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
